# ─── Deployer ────────────────────────────────────────────────────────────────
# Private key of the account that deploys and owns the contracts. Never commit it.
DEPLOYER_PRIVATE_KEY=

# ─── Robinhood Chain ─────────────────────────────────────────────────────────
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# Explorer (used by `hardhat verify`). Leave empty until you have them.
ROBINHOOD_EXPLORER_API_URL=
ROBINHOOD_EXPLORER_URL=
ROBINHOOD_EXPLORER_API_KEY=

# ─── Deployment parameters (all optional) ────────────────────────────────────
# Egg price in wei (default 0 = free sale until you call eggs.setPrice).
EGG_PRICE_WEI=
# Metadata base URI with trailing slash, e.g. ipfs://<cid>/
BASE_URI=
# Collection-level metadata URI
CONTRACT_URI=

# ─── Payout ──────────────────────────────────────────────────────────────────
# Address of the key the game server signs claim vouchers with. It can attest
# any amount, so keep it separate from the deployer. Falls back to the deployer
# at deploy time, with a warning; rotate later with payout.setSigner(...).
PAYOUT_SIGNER_ADDRESS=
# Used by scripts/fund-payout.ts. Both fall back to deployments/<network>.json.
PAYOUT_ADDRESS=
CRITTR_TOKEN_ADDRESS=
# Whole CRITTR to send when running scripts/fund-payout.ts, e.g. 1000000
AMOUNT=

# ─── Tooling ─────────────────────────────────────────────────────────────────
REPORT_GAS=false
# Set to "true" to stop `hardhat compile` from writing ABIs into ../web/src/lib/abi
SKIP_ABI_EXPORT=false
# Override the ABI export folder (relative to this package)
WEB_ABI_DIR=
# Optional: force an EVM target (e.g. paris) if the chain has no PUSH0/MCOPY yet
SOLIDITY_EVM_VERSION=
