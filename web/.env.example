# Where the world server runs (HTTP and /ws on the same origin).
NEXT_PUBLIC_SERVER_URL=http://localhost:8787

# Public site URL, used for metadata.
NEXT_PUBLIC_SITE_URL=https://crittr.farm

# X account. Placeholder until the real handle exists.
NEXT_PUBLIC_X_URL=https://x.com/crittrfarm

# Contracts. Empty means "not deployed yet" and the UI says so.
NEXT_PUBLIC_EGGS_ADDRESS=
NEXT_PUBLIC_CRITTR_TOKEN=
NEXT_PUBLIC_REWARD_POT=
NEXT_PUBLIC_PAYOUT=
NEXT_PUBLIC_HATCHERY=

# Robinhood Chain. Override only if you run your own RPC.
NEXT_PUBLIC_ROBINHOOD_CHAIN_ID=4663
NEXT_PUBLIC_ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_EXPLORER_URL=https://explorer.mainnet.chain.robinhood.com
