# CRITTR world server

# Port for HTTP and the /ws WebSocket.
PORT=8787

# SQLite file. The folder is created if missing.
DB_PATH=./data/crittr.sqlite

# Browser origin allowed to talk to the server. "*" for local development.
ORIGIN=*

# "open": a wallet is enough, new keepers pick a starter critter.
# "eggs": the door checks the egg collection; critters are hatched eggs.
GATE=open
EGGS_ADDRESS=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID=4663

# Multiplier on job durations (forage 120s, fish 180s, dig 240s at 1).
# 0.05 makes a forage six seconds long, handy while developing.
JOB_SCALE=1

ROOM_COUNT=5
ROOM_CAP=100
WILD_PER_ROOM=6
SESSION_DAYS=7
NAME_COOLDOWN_SECONDS=3600
APP_NAME=CRITTR

# ── Earning the token ───────────────────────────────────────────────
# Players cash gold out into a cumulative entitlement, then claim it from
# their own wallet with a voucher this server signs. All three of
# PAYOUT_ADDRESS, REWARD_TOKEN and PAYOUT_SIGNER_KEY must be set before
# anyone can cash out; with any missing, the bank panel says so and the
# button stays off.
PAYOUT_ADDRESS=
REWARD_TOKEN=
REWARD_TOKEN_SYMBOL=CRITTR
REWARD_TOKEN_DECIMALS=18

# The key that signs vouchers. Its address must match Payout.signer().
# Development only — in production this belongs in a signer service or a
# KMS, never in a file on the game server.
PAYOUT_SIGNER_KEY=

# Whole tokens paid per 1.00 gold. Shown in the game; it may change, and
# what has already been cashed out is not affected when it does.
TOKENS_PER_GOLD=10

# Smallest cash-out, in gold hundredths (100 = 1.00 gold).
MIN_CASHOUT_GOLD=100

# How long a signed voucher stays valid.
VOUCHER_MINUTES=30

# ── The game's own keepers ──────────────────────────────────────────
# Keepers the server walks around the meadow so the first person through
# the door does not arrive somewhere empty. They work spots, talk, and
# count in the room list — but they hold no wallet and can never earn or
# claim anything. Set to 0 for an empty world.
BOT_COUNT=34
BOT_CHAT=true
